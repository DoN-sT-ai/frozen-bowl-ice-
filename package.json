{
  "name": "fryfreeze",
  "productName": "FryFreeze",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "FryFreeze - Quick-Service POS & Kitchen Management System",
  "author": "FryFreeze",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs server.ts",
    "start": "node ./node_modules/tsx/dist/cli.mjs server.ts",
    "build": "node build.js",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "node ./node_modules/tsx/dist/cli.mjs tests/calculations.test.ts && node ./node_modules/tsx/dist/cli.mjs tests/inventoryLedgerEngine.test.ts && node ./node_modules/tsx/dist/cli.mjs tests/posModifierEndToEnd.test.ts && node ./node_modules/tsx/dist/cli.mjs tests/fullSoftwareE2E.ts",
    "app": "node electron/start.cjs",
    "desktop": "node electron/start.cjs",
    "electron": "node electron/start.cjs",
    "prebuild:installer": "node build.js",
    "build:installer": "npx electron-builder --win --x64",
    "build:msi": "npm run prebuild:installer && npx electron-builder --win msi --x64",
    "build:nsis": "npm run prebuild:installer && npx electron-builder --win nsis --x64"
  },
  "dependencies": {},
  "devDependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "png-to-ico": "^3.0.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "zod": "^4.6.5"
  },
  "build": {
    "appId": "com.fryfreeze.desktop",
    "productName": "FryFreeze",
    "copyright": "Copyright © 2024-2026 FryFreeze",
    "compression": "maximum",
    "directories": {
      "output": "installer-output",
      "buildResources": "assets"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".env",
        "to": ".env"
      },
      {
        "from": "dist/",
        "to": "app-dist",
        "filter": [
          "**/*",
          "!server.js"
        ]
      },
      {
        "from": "assets/",
        "to": "assets",
        "filter": [
          "icon.ico",
          "icon.png",
          "fryfreeze-logo.jpg"
        ]
      },
      {
        "from": "data/",
        "to": "data",
        "filter": [
          "ledgerstore.db"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FryFreeze",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "asar": true
  }
}
